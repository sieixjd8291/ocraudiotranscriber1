    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.3.0",
    "fix-webm-duration": "^1.0.6",
    "jszip": "^3.10.1",
    "lamejs": "^1.2.1",
    "lucide-react": "^0.546.0",
